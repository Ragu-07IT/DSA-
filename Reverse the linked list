#include<stdio.h>
#include<stdlib.h>
struct Node{
    int data;
    struct Node* next;
};
struct Node* head=NULL;
struct Node* createNode(int data){
    struct Node* temp=(struct Node*)malloc(sizeof(struct Node));
    temp->data=data;
    temp->next=NULL;
    return temp;
}

void insertfromBeg(int data){
    struct Node* newnode=createNode(data);
    newnode->next=head;
    head=newnode;
}

void display(){
    struct Node* temp=head;
    while(temp != NULL){
        printf("%d ",temp->data);
        temp=temp->next;
    }
}

int main(){
    int n,val;
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        scanf("%d",&val);
        insertfromBeg(val);
    }
    display();
    return 0;
}
